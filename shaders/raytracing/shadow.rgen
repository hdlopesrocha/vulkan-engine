#version 460
#extension GL_EXT_ray_tracing : enable
#include "rt_common.glsl"

// Shadow mask is a single-channel occlusion image (r32f). Writes only .r.
layout(set = 1, binding = 0, r32f) uniform image2D outImage;

layout(location = 0) rayPayloadEXT Payload payload;

void main() {
    vec3 origin, dir;
    computeCameraRay(origin, dir);

    payload.hit = 0.0;
    payload.color = vec3(0.0);
    payload.normal = vec3(0.0);
    payload.pos = vec3(0.0);

    uint rayFlags = gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsCullBackFacingTrianglesEXT;
    traceRayEXT(tlas, rayFlags, 0xFFu, 0u, 0u, 0u, origin, 0.01, dir, 10000.0, 0);

    // Occlusion: miss => unoccluded (full light), hit => shadowed.
    float lit = 1.0 - payload.hit;
    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), vec4(vec3(lit), 1.0));
}
