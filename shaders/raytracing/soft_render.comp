#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_NV_compute_shader_derivatives : enable
#include "ubo.glsl"
#include "textures.glsl"
#include "tbn.glsl"
#include "triplanar.glsl"

struct Vertex {
    vec3 position;
    vec3 color;
    vec2 texCoord;
    vec3 normal;
    int brushIndex;
    int _pad0;
    vec3 hsv;
};

struct ChunkInfo {
    uint baseVertex;
    uint firstIndex;
    uint indexCount;
    uint kind;
    vec3 aabbMin;
    float _pad0;
    vec3 aabbMax;
    float _pad1;
};

layout(scalar, set = 0, binding = 15) readonly buffer VertsSolid { Vertex vertsSolid[]; };
layout(scalar, set = 0, binding = 16) readonly buffer IdxsSolid { uint indicesSolid[]; };
layout(scalar, set = 0, binding = 17) readonly buffer VertsWater { Vertex vertsWater[]; };
layout(scalar, set = 0, binding = 18) readonly buffer IdxsWater { uint indicesWater[]; };
layout(scalar, set = 0, binding = 19) readonly buffer ChunkInfos { ChunkInfo chunks[]; };

layout(set = 1, binding = 0, rgba32f) uniform image2D outImage;

layout(push_constant) uniform PC {
    uint chunkCount;
} pc;

vec3 environmentColor(vec3 dir) {
    // Exact replica of shaders/sky.frag gradient for RT miss - must look identical to raster sky
    vec3 viewDir = normalize(dir);
    float t = clamp(viewDir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 horizonColor = sky.skyHorizon.rgb;
    vec3 zenithColor = sky.skyZenith.rgb;
    // If UBO is zero (not yet set), use a very distinct fallback that is obviously gradient
    bool isFallback = dot(horizonColor, horizonColor) < 0.001 && dot(zenithColor, zenithColor) < 0.001;
    if (isFallback) {
        horizonColor = vec3(0.75, 0.85, 0.95);
        zenithColor = vec3(0.05, 0.15, 0.45);
    }
    float userWarmth = clamp(sky.skyParams.x, 0.0, 1.0);
    float sunElev = -clamp(ubo.lightDir.y, -1.0, 1.0);
    float sunFactor = clamp((1.0 - sunElev) * 0.75, 0.0, 1.0);
    sunFactor = pow(sunFactor, 1.5);
    vec3 warmTint = vec3(1.0, 0.45, 0.2);
    horizonColor = mix(horizonColor, warmTint, sunFactor * userWarmth);
    float zenithWarm = smoothstep(0.0, 0.4, sunFactor) * 0.35 * userWarmth;
    zenithColor = mix(zenithColor, warmTint * 0.6, zenithWarm);
    float exponent = max(sky.skyParams.y, 0.01);
    if (!isFallback) exponent *= mix(1.0, 1.6, pow(sunFactor, 0.8));
    float tt = pow(t, exponent);
    vec3 dayColor = mix(horizonColor, zenithColor, tt);
    float dayFactor = smoothstep(-0.2, 0.2, sunElev);
    vec3 nightHor = sky.nightHorizon.rgb;
    vec3 nightZen = sky.nightZenith.rgb;
    float nightIntensity = clamp(sky.nightParams.x, 0.0, 1.0);
    bool nightFallback = dot(nightHor, nightHor) < 0.001 && dot(nightZen, nightZen) < 0.001;
    if (nightFallback) { nightHor = vec3(0.02, 0.02, 0.05); nightZen = vec3(0.00, 0.00, 0.02); }
    vec3 nightColor = mix(nightHor, nightZen, pow(t, max(sky.skyParams.y, 0.5)));
    vec3 c = mix(nightColor, dayColor, mix(dayFactor, 1.0, 1.0 - nightIntensity));
    return c;
}

bool rayTriangleIntersect(vec3 orig, vec3 dir, vec3 v0, vec3 v1, vec3 v2, out float t, out float u, out float v) {
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 p = cross(dir, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-8) return false;
    float invDet = 1.0 / det;
    vec3 tvec = orig - v0;
    u = dot(tvec, p) * invDet;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(tvec, e1);
    v = dot(dir, q) * invDet;
    if (v < 0.0 || u + v > 1.0) return false;
    t = dot(e2, q) * invDet;
    if (t < 0.001 || t > 1e30) return false;
    return true;
}

bool rayAABBIntersect(vec3 orig, vec3 invDir, vec3 bmin, vec3 bmax, float tMax) {
    vec3 t0 = (bmin - orig) * invDir;
    vec3 t1 = (bmax - orig) * invDir;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    float tNear = max(max(tmin.x, tmin.y), tmin.z);
    float tFar = min(min(tmax.x, tmax.y), tmax.z);
    return tNear <= tFar && tFar >= 0.0 && tNear <= tMax;
}

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(outImage);
    if (coord.x >= sz.x || coord.y >= sz.y) return;

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(sz);
    vec4 nearH = ubo.invViewProjection * vec4(uv * 2.0 - 1.0, 0.0, 1.0);
    vec4 farH  = ubo.invViewProjection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 nearP = nearH.xyz / nearH.w;
    vec3 farP  = farH.xyz / farH.w;
    vec3 origin = ubo.viewPos.xyz;
    vec3 dir = normalize(farP - nearP);
    vec3 invDir = 1.0 / dir;

    float closestT = 1e30;
    vec3 hitN = vec3(0,1,0);
    vec3 hitPos = vec3(0);
    vec3 hitBary = vec3(0);
    Vertex hitV0, hitV1, hitV2;
    uint hitKind = 0;
    bool hit = false;

    for (uint ci = 0; ci < pc.chunkCount; ++ci) {
        ChunkInfo c = chunks[ci];
        if (c.indexCount == 0) continue;
        if (!rayAABBIntersect(origin, invDir, c.aabbMin, c.aabbMax, closestT)) continue;
        for (uint i = 0; i < c.indexCount; i += 3) {
            Vertex vv0, vv1, vv2;
            vec3 v0, v1, v2;
            if (c.kind == 0) {
                uint idx0 = indicesSolid[c.firstIndex + i + 0];
                uint idx1 = indicesSolid[c.firstIndex + i + 1];
                uint idx2 = indicesSolid[c.firstIndex + i + 2];
                vv0 = vertsSolid[c.baseVertex + idx0];
                vv1 = vertsSolid[c.baseVertex + idx1];
                vv2 = vertsSolid[c.baseVertex + idx2];
            } else {
                uint idx0 = indicesWater[c.firstIndex + i + 0];
                uint idx1 = indicesWater[c.firstIndex + i + 1];
                uint idx2 = indicesWater[c.firstIndex + i + 2];
                vv0 = vertsWater[c.baseVertex + idx0];
                vv1 = vertsWater[c.baseVertex + idx1];
                vv2 = vertsWater[c.baseVertex + idx2];
            }
            v0 = vv0.position; v1 = vv1.position; v2 = vv2.position;
            float t, u, v;
            if (rayTriangleIntersect(origin, dir, v0, v1, v2, t, u, v)) {
                if (t < closestT) {
                    closestT = t;
                    float w = 1.0 - u - v;
                    // Interpolate normal
                    vec3 n0 = vv0.normal, n1 = vv1.normal, n2 = vv2.normal;
                    vec3 n = n0 * w + n1 * u + n2 * v;
                    if (length(n) < 0.5) n = normalize(cross(v1 - v0, v2 - v0));
                    else n = normalize(n);
                    hitN = n;
                    hitPos = origin + dir * t;
                    hitBary = vec3(w, u, v);
                    hitV0 = vv0; hitV1 = vv1; hitV2 = vv2;
                    hitKind = c.kind;
                    hit = true;
                }
            }
        }
    }

    vec3 color;
    if (hit) {
        if (dot(hitN, -dir) < 0.0) hitN = -hitN;
        vec3 geomN = hitN;
        // Triplanar weights
        vec3 triW = abs(geomN);
        float t = ubo.triplanarSettings.x;
        vec3 wt = max(vec3(0.0), triW - vec3(t));
        float e = max(1.0, ubo.triplanarSettings.y);
        wt = pow(wt, vec3(e));
        float triWSum = wt.x + wt.y + wt.z + 1e-6;
        triW = wt / triWSum;

        // Blend three materials per triangle using barycentrics
        ivec3 texIndices = ivec3(hitV0.brushIndex, hitV1.brushIndex, hitV2.brushIndex);
        vec3 w = hitBary;

        // Sample albedo: water is tinted with simple wave, solid uses triplanar
        vec3 albedo;
        if (hitKind == 1) {
            // Simple water tint with slight wave based on world pos
            float wave = sin(hitPos.x * 0.08 + ubo.viewPos.x * 0.01) * cos(hitPos.z * 0.08) * 0.04;
            albedo = vec3(0.15 + wave, 0.38 + wave, 0.68 + wave * 0.5);
        } else {
        float triFlag = 0.0;
        for (int k=0;k<3;k++) {
            int idx = (k==0? texIndices.x : (k==1? texIndices.y : texIndices.z));
            if (idx >= 0 && idx < 512) triFlag += materials[idx].triplanarParams.z * w[k];
        }
        if (triFlag > 0.5) {
            // Triplanar per-layer then blend
            vec3 a0 = vec3(0), a1 = vec3(0), a2 = vec3(0);
            if (w.x > 0.0) {
                vec2 uvX, uvY, uvZ;
                computeTriplanarUVs(hitPos, texIndices.x, geomN, uvX, uvY, uvZ);
                a0 = computeTriplanarAlbedoUVs(triW, texIndices.x, uvX, uvY, uvZ);
            }
            if (w.y > 0.0) {
                vec2 uvX, uvY, uvZ;
                computeTriplanarUVs(hitPos, texIndices.y, geomN, uvX, uvY, uvZ);
                a1 = computeTriplanarAlbedoUVs(triW, texIndices.y, uvX, uvY, uvZ);
            }
            if (w.z > 0.0) {
                vec2 uvX, uvY, uvZ;
                computeTriplanarUVs(hitPos, texIndices.z, geomN, uvX, uvY, uvZ);
                a2 = computeTriplanarAlbedoUVs(triW, texIndices.z, uvX, uvY, uvZ);
            }
            albedo = a0 * w.x + a1 * w.y + a2 * w.z;
            // If triplanar gave black (missing texture), fallback to flat
            if (dot(albedo, albedo) < 0.001) {
                albedo = vec3(0.7);
                if (hitKind == 1) albedo = vec3(0.20, 0.42, 0.72);
            }
        } else {
            // Direct UV sampling, blended
            vec2 uv0 = hitV0.texCoord, uv1 = hitV1.texCoord, uv2 = hitV2.texCoord;
            vec2 hitUV = uv0 * w.x + uv1 * w.y + uv2 * w.z;
            vec3 a0 = texture(albedoArray, vec3(hitUV, float(texIndices.x))).rgb;
            vec3 a1 = texture(albedoArray, vec3(hitUV, float(texIndices.y))).rgb;
            vec3 a2 = texture(albedoArray, vec3(hitUV, float(texIndices.z))).rgb;
            albedo = a0 * w.x + a1 * w.y + a2 * w.z;
            if (dot(albedo, albedo) < 0.001) {
                albedo = vec3(0.7);
            }
        }
        } // end solid vs water

        vec3 L = normalize(-ubo.lightDir.xyz);
        float ndl = max(dot(hitN, L), 0.0);
        bool shadowed = false;
        vec3 shadowOrig = hitPos + hitN * 0.05;
        vec3 invL = 1.0 / L;
        for (uint ci = 0; ci < pc.chunkCount && !shadowed; ++ci) {
            ChunkInfo c = chunks[ci];
            if (c.indexCount == 0) continue;
            if (!rayAABBIntersect(shadowOrig, invL, c.aabbMin, c.aabbMax, 10000.0)) continue;
            for (uint i = 0; i < c.indexCount; i += 3) {
                vec3 v0, v1, v2;
                if (c.kind == 0) {
                    uint idx0 = indicesSolid[c.firstIndex + i + 0];
                    uint idx1 = indicesSolid[c.firstIndex + i + 1];
                    uint idx2 = indicesSolid[c.firstIndex + i + 2];
                    v0 = vertsSolid[c.baseVertex + idx0].position;
                    v1 = vertsSolid[c.baseVertex + idx1].position;
                    v2 = vertsSolid[c.baseVertex + idx2].position;
                } else {
                    uint idx0 = indicesWater[c.firstIndex + i + 0];
                    uint idx1 = indicesWater[c.firstIndex + i + 1];
                    uint idx2 = indicesWater[c.firstIndex + i + 2];
                    v0 = vertsWater[c.baseVertex + idx0].position;
                    v1 = vertsWater[c.baseVertex + idx1].position;
                    v2 = vertsWater[c.baseVertex + idx2].position;
                }
                float t, u, v;
                if (rayTriangleIntersect(shadowOrig, L, v0, v1, v2, t, u, v)) {
                    if (t > 0.001 && t < 10000.0) { shadowed = true; break; }
                }
            }
        }
        float shadow = shadowed ? 1.0 : 0.0;
        vec3 direct = albedo * (0.15 + 0.85 * ndl * (1.0 - shadow)) * ubo.lightColor.rgb;
        vec3 ambient = albedo * 0.18 * mix(sky.skyHorizon.rgb, sky.skyZenith.rgb, 0.5);
        color = direct + ambient;
        // Traced reflection: only for water (0.35 strength) do brute-force; solid keeps cheap env to stay under TDR
        vec3 reflDir = reflect(dir, hitN);
        vec3 reflColor = environmentColor(reflDir);
        bool doTracedRefl = (hitKind == 1); // water only
        if (doTracedRefl) {
            vec3 ro = hitPos + hitN * 0.05;
            vec3 rd = reflDir;
            vec3 invRd = 1.0 / rd;
            float tMin = 1e30;
            vec3 rHitN = vec3(0);
            vec3 rHitPos = vec3(0);
            vec3 rHitBary = vec3(0);
            Vertex rV0, rV1, rV2;
            uint rKind = 0;
            bool rHit = false;
            for (uint ci = 0; ci < pc.chunkCount; ++ci) {
                ChunkInfo c = chunks[ci];
                if (c.indexCount == 0) continue;
                if (!rayAABBIntersect(ro, invRd, c.aabbMin, c.aabbMax, tMin)) continue;
                for (uint i = 0; i < c.indexCount; i += 3) {
                    Vertex vv0, vv1, vv2;
                    vec3 v0, v1, v2;
                    if (c.kind == 0) {
                        uint idx0 = indicesSolid[c.firstIndex + i + 0];
                        uint idx1 = indicesSolid[c.firstIndex + i + 1];
                        uint idx2 = indicesSolid[c.firstIndex + i + 2];
                        vv0 = vertsSolid[c.baseVertex + idx0];
                        vv1 = vertsSolid[c.baseVertex + idx1];
                        vv2 = vertsSolid[c.baseVertex + idx2];
                    } else {
                        uint idx0 = indicesWater[c.firstIndex + i + 0];
                        uint idx1 = indicesWater[c.firstIndex + i + 1];
                        uint idx2 = indicesWater[c.firstIndex + i + 2];
                        vv0 = vertsWater[c.baseVertex + idx0];
                        vv1 = vertsWater[c.baseVertex + idx1];
                        vv2 = vertsWater[c.baseVertex + idx2];
                    }
                    v0 = vv0.position; v1 = vv1.position; v2 = vv2.position;
                    float t, u, v;
                    if (rayTriangleIntersect(ro, rd, v0, v1, v2, t, u, v)) {
                        if (t < tMin) {
                            tMin = t;
                            float w = 1.0 - u - v;
                            vec3 n = vv0.normal * w + vv1.normal * u + vv2.normal * v;
                            if (length(n) < 0.5) n = normalize(cross(v1 - v0, v2 - v0));
                            rHitN = normalize(n);
                            if (dot(rHitN, -rd) < 0.0) rHitN = -rHitN;
                            rHitPos = ro + rd * t;
                            rHitBary = vec3(w, u, v);
                            rV0 = vv0; rV1 = vv1; rV2 = vv2;
                            rKind = c.kind;
                            rHit = true;
                        }
                    }
                }
            }
            if (rHit) {
                // Shade the reflected hit simply (albedo + ambient, no secondary shadow for perf)
                ivec3 rTexIdx = ivec3(rV0.brushIndex, rV1.brushIndex, rV2.brushIndex);
                vec3 rw = rHitBary;
                vec3 rAlbedo = vec3(0.7);
                // triplanar check
                float rTriFlag = 0.0;
                for (int k=0;k<3;k++) {
                    int idx = (k==0? rTexIdx.x : (k==1? rTexIdx.y : rTexIdx.z));
                    if (idx >= 0 && idx < 512) rTriFlag += materials[idx].triplanarParams.z * rw[k];
                }
                if (rTriFlag > 0.5) {
                    vec3 rrTriW = abs(rHitN);
                    float rt = ubo.triplanarSettings.x;
                    vec3 rwt = max(vec3(0.0), rrTriW - vec3(rt));
                    float re = max(1.0, ubo.triplanarSettings.y);
                    rwt = pow(rwt, vec3(re));
                    float rSum = rwt.x + rwt.y + rwt.z + 1e-6;
                    rrTriW = rwt / rSum;
                    vec3 ra0 = vec3(0), ra1 = vec3(0), ra2 = vec3(0);
                    if (rw.x > 0.0) { vec2 uvX, uvY, uvZ; computeTriplanarUVs(rHitPos, rTexIdx.x, rHitN, uvX, uvY, uvZ); ra0 = computeTriplanarAlbedoUVs(rrTriW, rTexIdx.x, uvX, uvY, uvZ); }
                    if (rw.y > 0.0) { vec2 uvX, uvY, uvZ; computeTriplanarUVs(rHitPos, rTexIdx.y, rHitN, uvX, uvY, uvZ); ra1 = computeTriplanarAlbedoUVs(rrTriW, rTexIdx.y, uvX, uvY, uvZ); }
                    if (rw.z > 0.0) { vec2 uvX, uvY, uvZ; computeTriplanarUVs(rHitPos, rTexIdx.z, rHitN, uvX, uvY, uvZ); ra2 = computeTriplanarAlbedoUVs(rrTriW, rTexIdx.z, uvX, uvY, uvZ); }
                    rAlbedo = ra0 * rw.x + ra1 * rw.y + ra2 * rw.z;
                    if (dot(rAlbedo, rAlbedo) < 0.001) { rAlbedo = vec3(0.7); if (rKind == 1) rAlbedo = vec3(0.20, 0.42, 0.72); }
                } else {
                    vec2 rUV = rV0.texCoord * rw.x + rV1.texCoord * rw.y + rV2.texCoord * rw.z;
                    vec3 a0 = texture(albedoArray, vec3(rUV, float(rTexIdx.x))).rgb;
                    vec3 a1 = texture(albedoArray, vec3(rUV, float(rTexIdx.y))).rgb;
                    vec3 a2 = texture(albedoArray, vec3(rUV, float(rTexIdx.z))).rgb;
                    rAlbedo = a0 * rw.x + a1 * rw.y + a2 * rw.z;
                    if (dot(rAlbedo, rAlbedo) < 0.001) { rAlbedo = vec3(0.7); if (rKind == 1) rAlbedo = vec3(0.20, 0.42, 0.72); }
                }
                vec3 L2 = normalize(-ubo.lightDir.xyz);
                float rNdl = max(dot(rHitN, L2), 0.0);
                vec3 rDirect = rAlbedo * (0.15 + 0.85 * rNdl) * ubo.lightColor.rgb;
                vec3 rAmbient = rAlbedo * 0.18 * mix(sky.skyHorizon.rgb, sky.skyZenith.rgb, 0.5);
                reflColor = rDirect + rAmbient;
            }
        }
        float fresnel = 0.04 + 0.96 * pow(1.0 - max(dot(hitN, -dir), 0.0), 5.0);
        float reflStrength = (hitKind == 1) ? 0.65 : 0.12;
        color = mix(color, reflColor, fresnel * reflStrength);
        // Water refraction (single bounce, tinted) - only for water to keep perf
        if (hitKind == 1) {
            vec3 transDir = refract(dir, hitN, 0.85);
            if (dot(transDir, transDir) > 1e-4) {
                vec3 tro = hitPos - hitN * 0.05;
                vec3 invTr = 1.0 / transDir;
                float tMin2 = 1e30;
                vec3 tHitN = vec3(0); vec3 tHitPos = vec3(0); vec3 tHitBary = vec3(0);
                Vertex tV0, tV1, tV2; uint tKind = 0; bool tHit = false;
                for (uint ci = 0; ci < pc.chunkCount; ++ci) {
                    ChunkInfo c = chunks[ci];
                    if (c.indexCount == 0) continue;
                    if (!rayAABBIntersect(tro, invTr, c.aabbMin, c.aabbMax, tMin2)) continue;
                    for (uint i = 0; i < c.indexCount; i += 3) {
                        Vertex vv0, vv1, vv2; vec3 v0, v1, v2;
                        if (c.kind == 0) {
                            uint idx0 = indicesSolid[c.firstIndex + i + 0];
                            uint idx1 = indicesSolid[c.firstIndex + i + 1];
                            uint idx2 = indicesSolid[c.firstIndex + i + 2];
                            vv0 = vertsSolid[c.baseVertex + idx0]; vv1 = vertsSolid[c.baseVertex + idx1]; vv2 = vertsSolid[c.baseVertex + idx2];
                        } else {
                            uint idx0 = indicesWater[c.firstIndex + i + 0];
                            uint idx1 = indicesWater[c.firstIndex + i + 1];
                            uint idx2 = indicesWater[c.firstIndex + i + 2];
                            vv0 = vertsWater[c.baseVertex + idx0]; vv1 = vertsWater[c.baseVertex + idx1]; vv2 = vertsWater[c.baseVertex + idx2];
                        }
                        v0 = vv0.position; v1 = vv1.position; v2 = vv2.position;
                        float t, u, v;
                        if (rayTriangleIntersect(tro, transDir, v0, v1, v2, t, u, v)) {
                            if (t < tMin2) {
                                tMin2 = t; float w = 1.0 - u - v;
                                vec3 n = vv0.normal * w + vv1.normal * u + vv2.normal * v;
                                if (length(n) < 0.5) n = normalize(cross(v1 - v0, v2 - v0));
                                tHitN = normalize(n); if (dot(tHitN, -transDir) < 0.0) tHitN = -tHitN;
                                tHitPos = tro + transDir * t; tHitBary = vec3(w,u,v); tV0=vv0; tV1=vv1; tV2=vv2; tKind=c.kind; tHit=true;
                            }
                        }
                    }
                }
                vec3 transColor = environmentColor(transDir);
                if (tHit) {
                    ivec3 tTexIdx = ivec3(tV0.brushIndex, tV1.brushIndex, tV2.brushIndex);
                    vec3 tw = tHitBary;
                    vec3 tAlbedo = vec3(0.7);
                    float tTriFlag = 0.0;
                    for (int k=0;k<3;k++) { int idx=(k==0? tTexIdx.x : (k==1? tTexIdx.y : tTexIdx.z)); if (idx>=0 && idx<512) tTriFlag += materials[idx].triplanarParams.z * tw[k]; }
                    if (tTriFlag > 0.5) {
                        vec3 rTriW = abs(tHitN); float rt = ubo.triplanarSettings.x; vec3 rwt = max(vec3(0.0), rTriW - vec3(rt)); float re = max(1.0, ubo.triplanarSettings.y); rwt = pow(rwt, vec3(re)); float rSum = rwt.x + rwt.y + rwt.z + 1e-6; rTriW = rwt / rSum;
                        vec3 ra0=vec3(0),ra1=vec3(0),ra2=vec3(0);
                        if (tw.x>0.0) { vec2 uvX,uvY,uvZ; computeTriplanarUVs(tHitPos, tTexIdx.x, tHitN, uvX, uvY, uvZ); ra0 = computeTriplanarAlbedoUVs(rTriW, tTexIdx.x, uvX, uvY, uvZ); }
                        if (tw.y>0.0) { vec2 uvX,uvY,uvZ; computeTriplanarUVs(tHitPos, tTexIdx.y, tHitN, uvX, uvY, uvZ); ra1 = computeTriplanarAlbedoUVs(rTriW, tTexIdx.y, uvX, uvY, uvZ); }
                        if (tw.z>0.0) { vec2 uvX,uvY,uvZ; computeTriplanarUVs(tHitPos, tTexIdx.z, tHitN, uvX, uvY, uvZ); ra2 = computeTriplanarAlbedoUVs(rTriW, tTexIdx.z, uvX, uvY, uvZ); }
                        tAlbedo = ra0 * tw.x + ra1 * tw.y + ra2 * tw.z;
                        if (dot(tAlbedo,tAlbedo)<0.001) { tAlbedo=vec3(0.7); if (tKind==1) tAlbedo=vec3(0.20,0.42,0.72); }
                    } else {
                        vec2 tUV = tV0.texCoord * tw.x + tV1.texCoord * tw.y + tV2.texCoord * tw.z;
                        vec3 a0 = texture(albedoArray, vec3(tUV, float(tTexIdx.x))).rgb;
                        vec3 a1 = texture(albedoArray, vec3(tUV, float(tTexIdx.y))).rgb;
                        vec3 a2 = texture(albedoArray, vec3(tUV, float(tTexIdx.z))).rgb;
                        tAlbedo = a0 * tw.x + a1 * tw.y + a2 * tw.z;
                        if (dot(tAlbedo,tAlbedo)<0.001) { tAlbedo=vec3(0.7); if (tKind==1) tAlbedo=vec3(0.20,0.42,0.72); }
                    }
                    vec3 L2 = normalize(-ubo.lightDir.xyz);
                    float tNdl = max(dot(tHitN, L2), 0.0);
                    vec3 tDirect = tAlbedo * (0.15 + 0.85 * tNdl) * ubo.lightColor.rgb;
                    vec3 tAmbient = tAlbedo * 0.18 * mix(sky.skyHorizon.rgb, sky.skyZenith.rgb, 0.5);
                    transColor = tDirect + tAmbient;
                }
                vec3 tint = vec3(0.25, 0.50, 0.75);
                color = mix(color, transColor * tint, 0.45);
            }
        }
    } else {
        color = environmentColor(dir);
    }

    imageStore(outImage, coord, vec4(color, 1.0));
}
