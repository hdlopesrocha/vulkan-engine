#version 460
#extension GL_EXT_ray_tracing : enable
#include "rt_common.glsl"

// Any-hit for vegetation instances. Vegetation is registered as FORCE_OPAQUE so
// this any-hit is skipped by default; the alpha test itself is performed in the
// closest-hit shader (which decides occlusion for shadow rays). This keeps the
// logic in one place and avoids relying on any-hit terminators. The body is a
// no-op accepting the intersection.
void main() {
    // accept
}
