#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

// Solid input draw commands (one per terrain chunk entry, indexed 0..numCmds-1).
layout(std430, binding = 0) readonly buffer InCmds {
    DrawCmd cmds[];
} inCmds;

// Compacted SOLID output draw commands (frustum + LoD culled).
layout(std430, binding = 1) writeonly buffer OutCmds {
    DrawCmd cmds[];
} outCmds;

// Solid per-entry bounds + LoD meta (vec4 triples, indexed 0..numCmds-1):
//   min, max, lodMeta{cellSize, level, maxLevel, unused}.
// cellSize <= 0 marks an entry with no LoD data (always kept).
layout(std430, binding = 2) readonly buffer Bounds {
    vec4 data[];
} boundsBuf;

// Solid visible (compacted) count.
layout(std430, binding = 3) buffer VisibleCount {
    uint count;
};

// Chosen-LoD output, one uvec2 per SOLID draw entry: {drawIndex, selectedLevel}.
// selectedLevel == 0xFFFFFFFF marks an entry with no LoD data. Read-write: the
// cascade branch reads the level the main branch stamped for the shadow cull.
layout(std430, binding = 4) buffer VisibleLods {
    uvec2 data[];
} visibleLods;

// ── Vegetation outputs ───────────────────────────────────────────────────────
// Emitted by processVegetation() for every VISIBLE solid chunk that carries
// vegetation. We reuse the solid chunk's AABB (boundsBuf[s]), so vegetation is
// implicitly culled by the same frustum test as its terrain chunk (step 4: the
// vegetation bounding box IS the solid terrain chunk AABB). Billboards use
// indexCount=36, impostors indexCount=6 — each into its own compact stream.
layout(std430, binding = 5) writeonly buffer OutVegImpCmds {
    DrawCmd cmds[];
} outVegImp;
layout(std430, binding = 6) buffer VegImpCount {
    uint count;
} vegImpCount;

// Vegetation billboard output stream (indexCount=36) + its count.
layout(std430, binding = 7) writeonly buffer OutVegBbCmds {
    DrawCmd cmds[];
} outVegBb;
layout(std430, binding = 8) buffer VegBbCount {
    uint count;
} vegBbCount;

// Per-solid-chunk vegetation table (indexed by the SAME draw index s as the
// solid entry): {instanceCount, firstInstance, pad, pad}. instanceCount < 1
// means the chunk has no vegetation. Binding 9.
layout(std430, binding = 9) readonly buffer VegChunkInfo {
    vec4 data[];
} vegChunkInfo;

// ── SDF debug-cube culling (folded into the SAME solid dispatch) ──────────────
// SDF cubes are appended AFTER the solid/veg entries in the dispatch (input index
// s in [terrainCount, terrainCount+sdfCount)). They carry no LoD data, so they are
// frustum-culled only and written to a dedicated SDF output stream so the solid
// indirect draw (which uses a different vertex buffer) is never polluted by them.
layout(std430, binding = 12) readonly buffer InSdfCmds {
    DrawCmd cmds[];
} inSdfCmds;
layout(std430, binding = 13) readonly buffer BoundsSdf {
    vec4 data[];
} boundsSdf;
layout(std430, binding = 10) writeonly buffer OutSdfCmds {
    DrawCmd cmds[];
} outSdfCmds;
layout(std430, binding = 11) buffer OutSdfCount {
    uint count;
} sdfCount;

// ── Mesh bounding-box culling (folded into the SAME solid dispatch) ──────────
// Bounding boxes are appended AFTER the solid + SDF entries (input index s in
// [terrainCount + sdfCount, terrainCount + sdfCount + bboxCount)). They carry no
// LoD data, so they are frustum-culled only and written to a dedicated stream so
// the solid indirect draw (different vertex buffer + line topology) is never
// polluted by them.
layout(std430, binding = 14) readonly buffer BoundsBbox {
    vec4 data[];
} boundsBbox;
layout(std430, binding = 15) writeonly buffer OutBboxCmds {
    DrawCmd cmds[];
} outBboxCmds;
layout(std430, binding = 16) buffer OutBboxCount {
    uint count;
} bboxCount;

// ── Cascade (shadow) culling outputs ──────────────────────────────────────────
// Folded into the SAME dispatch as the main-view cull when pc.doCascade == 1.
// Each entry is independently tested against the 3 cascade view-projection
// matrices and appended to the cascade stream(s) it is visible in. firstInstance
// is the draw entry index, so the shadow draw reconstructs the mesh via the same
// InstanceBuffer lookup as the main pass.
layout(std430, binding = 17) readonly buffer CascadeMatrices {
    mat4 viewProj[3];
} cascades;

layout(std430, binding = 18) writeonly buffer OutCascade0 {
    DrawCmd cmds[];
} outCasc0;
layout(std430, binding = 19) buffer CascadeCount0 {
    uint count;
} cc0;
layout(std430, binding = 20) writeonly buffer OutCascade1 {
    DrawCmd cmds[];
} outCasc1;
layout(std430, binding = 21) buffer CascadeCount1 {
    uint count;
} cc1;
layout(std430, binding = 22) writeonly buffer OutCascade2 {
    DrawCmd cmds[];
} outCasc2;
layout(std430, binding = 23) buffer CascadeCount2 {
    uint count;
} cc2;

// ── Vegetation cascade (shadow) outputs ────────────────────────────────────────
// Folded into the SAME dispatch as the main-view cull when pc.doVegCascade == 1.
// Each vegetation chunk (not solid draw entry) is frustum-culled against the 3
// cascade frustums and two command streams are emitted per cascade: billboards
// (indexCount=36) and impostors (indexCount=6), each with the chunk's instance
// count + firstInstance so the shadow billboard/impostor draws reconstruct the
// instance range. Mirrors the retired veg_cascade_cull.comp.
layout(std430, binding = 24) readonly buffer VegCascadeChunkInfo {
    vec4 data[];
} vegCascadeInfo;

layout(std430, binding = 25) writeonly buffer VegBbCascade0 { DrawCmd cmds[]; } vegBbCasc0;
layout(std430, binding = 26) buffer VegBbCascadeCount0 { uint count; } vegBbCascCnt0;
layout(std430, binding = 27) writeonly buffer VegBbCascade1 { DrawCmd cmds[]; } vegBbCasc1;
layout(std430, binding = 28) buffer VegBbCascadeCount1 { uint count; } vegBbCascCnt1;
layout(std430, binding = 29) writeonly buffer VegBbCascade2 { DrawCmd cmds[]; } vegBbCasc2;
layout(std430, binding = 30) buffer VegBbCascadeCount2 { uint count; } vegBbCascCnt2;

layout(std430, binding = 31) writeonly buffer VegImpCascade0 { DrawCmd cmds[]; } vegImpCasc0;
layout(std430, binding = 32) buffer VegImpCascadeCount0 { uint count; } vegImpCascCnt0;
layout(std430, binding = 33) writeonly buffer VegImpCascade1 { DrawCmd cmds[]; } vegImpCasc1;
layout(std430, binding = 34) buffer VegImpCascadeCount1 { uint count; } vegImpCascCnt1;
layout(std430, binding = 35) writeonly buffer VegImpCascade2 { DrawCmd cmds[]; } vegImpCasc2;
layout(std430, binding = 36) buffer VegImpCascadeCount2 { uint count; } vegImpCascCnt2;

layout(push_constant) uniform PC {
    layout(offset = 0)   mat4 viewProj;
    layout(offset = 64)  uint targetLayer; // 0 = LAYER_OPAQUE, 1 = LAYER_TRANSPARENT (unused for now)
    layout(offset = 68)  uint numCmds;     // number of TOTAL draw commands (solid + sdf)
    layout(offset = 80)  vec3 camPos;      // camera position driving the per-chunk LoD band selection
    layout(offset = 96)  float lodBias;    // world distance per LoD rung: larger = coarser levels kick in farther away
    layout(offset = 100) uint maxTargetLod; // clamp: never select a coarser LoD level than this
    layout(offset = 104) uint numCmdsVeg;   // legacy/unused in the merged dispatch (kept for layout compatibility)
    layout(offset = 108) uint terrainCount; // number of SOLID draw commands (s < terrainCount)
    layout(offset = 112) uint sdfCount;     // number of SDF cube entries (appended after solid)
    layout(offset = 116) uint bboxCount;    // number of mesh bounding-box entries (appended after solid + sdf)
    layout(offset = 120) uint doCascade;         // emit cascade (shadow) streams when 1
    layout(offset = 124) uint cascadeEntryCount; // number of entries to cascade-cull
    layout(offset = 128) uint doMain;           // emit main-view streams when 1
    layout(offset = 132) uint doVegCascade;      // emit vegetation cascade (shadow) streams when 1
    layout(offset = 136) uint vegChunkCount;     // number of veg chunks to cascade-cull
} pc;

// Shared, per-workgroup cache of the six frustum planes. The viewProj matrix is
// a push constant identical for every invocation of a dispatch, so extracting and
// normalizing the planes once per workgroup (instead of once per invocation) avoids
// thousands of redundant length()/divide ALU ops per frame.
shared vec4 gPlanes[6];

// Normalize a frustum plane (n, d) by its normal length so the distance test is
// stable. Length is never zero for a valid view-projection matrix.
vec4 normalizePlane(vec4 pl) {
    float len = length(pl.xyz);
    return pl / max(len, 1e-8);
}

// Robust AABB vs frustum test. `planes` already holds the normalized clip-space
// planes (left, right, bottom, top, near, far). Normalization keeps the distance
// test stable and avoids false negatives when the camera is inside the AABB.
bool aabbVisible(vec4 planes[6], vec3 minp, vec3 maxp) {
    // For each plane, test the AABB's most positive (closest) vertex
    for (int i = 0; i < 6; ++i) {
        vec3 n = planes[i].xyz;
        float d = planes[i].w;

        vec3 p;
        p.x = (n.x >= 0.0) ? maxp.x : minp.x;
        p.y = (n.y >= 0.0) ? maxp.y : minp.y;
        p.z = (n.z >= 0.0) ? maxp.z : minp.z;
        float dist = dot(n, p) + d;
        if (dist < 0.0) {
            // AABB is completely outside this plane
            return false;
        }
    }

    // Passed all plane tests => box intersects or is inside frustum
    return true;
}

// Emit the billboard (indexCount=36) and impostor (indexCount=6) draw commands
// for a solid chunk that survived culling. Called from processChunk once the
// chunk is known visible, so no extra AABB test is needed — vegetation shares
// the terrain chunk's bounding box.
void processVegetation(uint s) {
    if (s >= vegChunkInfo.data.length()) return;
    vec4 meta = vegChunkInfo.data[s];
    if (meta.x < 1.0) return; // no vegetation in this chunk

    uint instanceCount = uint(meta.x);
    uint firstInstance  = uint(meta.y);

    DrawCmd bbCmd;
    bbCmd.indexCount    = 36u;
    bbCmd.instanceCount = instanceCount;
    bbCmd.firstIndex    = 0u;
    bbCmd.vertexOffset  = 0;
    bbCmd.firstInstance = firstInstance;
    uint dstB = atomicAdd(vegBbCount.count, 1u);
    if (dstB < outVegBb.cmds.length()) outVegBb.cmds[dstB] = bbCmd;

    DrawCmd impCmd = bbCmd;
    impCmd.indexCount = 6u;
    uint dstI = atomicAdd(vegImpCount.count, 1u);
    if (dstI < outVegImp.cmds.length()) outVegImp.cmds[dstI] = impCmd;
}

// Cull one solid terrain chunk (frustum + per-chunk LoD band) and emit its
// compacted solid command. If the chunk is kept, its vegetation is emitted too
// via processVegetation (so vegetation is drawn exactly for the visible chunks).
void processChunk(uint s) {
    if (s >= pc.numCmds) return;

    // ── SDF debug cubes (appended after the solid entries) ───────────────────
    // SDF debug cubes: one dispatch entry per collected cube. requestSDFCubes only
    // emits lod==1 surface nodes, so every entry here already satisfies the
    // chunkLod == 1 gate. Emit a frustum-culled draw command PER cube, with
    // firstInstance = the cube's SDF-local index so the SDF vertex shader reads
    // instances[gl_InstanceIndex] for exactly the right AABB. Written to a dedicated
    // SDF output stream so the solid indirect draw (different vertex buffer) is never
    // polluted by SDF draw commands.
    // ── Mesh bounding boxes (appended after solid + SDF) ──
    // One dispatch entry per collected AABB. They carry the LoD meta (cellSize, level,
    // base) so the same clipmap band gate as the solid terrain keeps exactly one rung
    // per region. They are written to a dedicated bbox output stream so the solid
    // indirect draw (different vertex buffer + line topology) is never polluted by
    // them. firstInstance = the bbox-local index so the bounding-box vertex shader
    // reads instances[gl_InstanceIndex] for exactly the right AABB.
    if (s >= pc.terrainCount + pc.sdfCount) {
        uint local = s - (pc.terrainCount + pc.sdfCount);
        if (local >= pc.bboxCount) return;

        // boundsBbox stride is 4 vec4 per box: {min, max, lodMeta, base}.
        vec3 bmin = boundsBbox.data[local * 4u + 0u].xyz;
        vec3 bmax = boundsBbox.data[local * 4u + 1u].xyz;
        vec4 lodMeta = boundsBbox.data[local * 4u + 2u];
        vec3 base = boundsBbox.data[local * 4u + 3u].xyz;

        // ── LoD band gate (mirrors the solid chunk gate) ──
        // Draw a chunk box only if its rung matches the rung selected by distance
        // from the camera to the chunk's own centre. Because the band uses the chunk
        // centre (not a column-shared anchor snapped to rootSide), parent and child
        // boxes in a column derive different bands and exactly one rung survives per
        // region — so boxes never overlap across LoD (no overdraw) and no chunk is
        // dropped (no holes). Entries with no LoD data (cellSize <= 0) fall through
        // and are kept (frustum-only, legacy).
        float cellSize = lodMeta.x;
        int entryLevel = int(lodMeta.y + 0.5);
        int maxLevel   = int(lodMeta.z + 0.5);
        if (cellSize > 0.0) {
            float baseCell = cellSize / exp2(float(max(entryLevel, 0))); // == G/2, invariant
            vec3  center   = base + 0.5f * cellSize;                     // this chunk's centre
            float band = distance(pc.camPos, center) / (baseCell * pc.lodBias);
            uint selectedLevel = uint(floor(band));
            selectedLevel = uint(min(float(selectedLevel), float(maxLevel)));
            selectedLevel = uint(max(float(selectedLevel), 0.0f));        // 0 = finest (0-based rung)
            selectedLevel = uint(min(float(selectedLevel), float(pc.maxTargetLod)));
            if (uint(entryLevel) != selectedLevel) return;
        }

        if (!aabbVisible(gPlanes, bmin, bmax)) return;

        uint dst = atomicAdd(bboxCount.count, 1u);
        if (dst < outBboxCmds.cmds.length()) {
            DrawCmd cmd;
            cmd.indexCount    = 24u; // line-cube (12 edges)
            cmd.instanceCount = 1u;
            cmd.firstIndex    = 0u;
            cmd.vertexOffset  = 0;
            cmd.firstInstance = local;
            outBboxCmds.cmds[dst] = cmd;
        }
        return;
    }

    if (s >= pc.terrainCount) {
        uint local = s - pc.terrainCount;
        if (local >= pc.sdfCount) return;

        // chunkLod == 1 gate (restated in-shader for clarity): all collected cubes
        // carry chunkLod == 1, so this is always satisfied here.
        if (inSdfCmds.cmds[local].instanceCount == 0u) return; // not a valid cube slot

        // boundsSdf stride is 4 vec4 per cube: {min, max, lodMeta, base}.
        // SDF debug cubes are a frustum-only overlay: they mark where SDF faces
        // exist at every resolution, so we intentionally do NOT apply the clipmap
        // LOD band gate (unlike the solid/bbox streams). Only the frustum test
        // below can drop them, which is what lets all in-view SDF cubes render.
        vec3 bmin = boundsSdf.data[local * 4u + 0u].xyz;
        vec3 bmax = boundsSdf.data[local * 4u + 1u].xyz;

        // frustum visibility
        if (!aabbVisible(gPlanes, bmin, bmax)) return;

        uint dst = atomicAdd(sdfCount.count, 1u);
        if (dst < outSdfCmds.cmds.length()) {
            DrawCmd cmd;
            cmd.indexCount    = 36u;
            cmd.instanceCount = 1u;
            cmd.firstIndex    = 0u;
            cmd.vertexOffset  = 0;
            cmd.firstInstance = local;
            outSdfCmds.cmds[dst] = cmd;
        }
        return;
    }

    if (s >= inCmds.cmds.length()) return;

    // Empty entries (no mesh data) never draw, never count, and carry no vegetation.
    if (inCmds.cmds[s].indexCount == 0u) return;

    // bounds stored as min, max, meta triples in `boundsBuf.data`
    // meta = {cellSize, level, maxLevel, unused}: level is the 0-based band
    // rung (0 = finest published rung), maxLevel is the tree's real ladder
    // depth (0-based, from maxChunkLod).
    uint bIndex = s * 4u;
    bool hasBounds = (bIndex + 3u) < boundsBuf.data.length();
    vec3 minp = vec3(0.0);
    vec3 maxp = vec3(0.0);
    vec4 lodMeta = vec4(0.0);
    vec3 base = vec3(0.0);
    if (hasBounds) {
        minp = boundsBuf.data[bIndex].xyz;
        maxp = boundsBuf.data[bIndex + 1u].xyz;
        lodMeta = boundsBuf.data[bIndex + 2u];
        base = boundsBuf.data[bIndex + 3u].xyz;
    }

    // ── Per-chunk LoD band selection (frustum-independent) ──────────────────
    // Each chunk publishes one band per chunkLod rung. Distance alone picks the
    // rung to draw: floor(dist(camPos, chunkCenter) / lodBias) is the band
    // index, and the gate below keeps the entry whose chunkLod matches it.
    // lodBias is the world distance per rung (a settings value). The selection
    // is computed for EVERY non-empty entry — even ones outside the camera
    // frustum — and stamped into visibleLods, so the shadow cascade cull reads
    // the exact same level instead of re-deriving the band with a stale camera
    // position. (The band depends only on distance to the camera,

    // The selection is computed for EVERY non-empty entry — even ones outside
    // the camera frustum — and stamped into visibleLods, so the shadow cascade
    // cull reads the exact same level instead of re-deriving the band with a
    // stale camera position. (The band depends only on distance to the camera,
    // not on the frustum.)
    // Per-entry LoD rung: level is the 0-based band rung (0 = finest
    // published rung). Distance alone selects the rung to draw; no geometric
    // sizes are involved.
    // Per-chunk LoD band selection (frustum-independent). Each published entry is
    // one chunk (node) at a single rung; distance selects which rung to draw and
    // the gate keeps exactly the one whose rung matches. This is a clipmap ladder:
    // chunk levels double in size per rung, so baseCell == G/2 is invariant and the
    // band is a pure function of distance from the camera to the chunk's centre;
    // nested rungs in a column derive different bands so exactly one rung survives
    // per region. That is why cellSize is needed — it is the chunk's own cube
    // length, not "crap".
    float cellSize = lodMeta.x;
    int entryLevel = int(lodMeta.y + 0.5);
    int maxLevel   = int(lodMeta.z + 0.5);

    uint selectedLevel = 0xFFFFFFFFu;
    if (cellSize > 0.0) {
        // Clipmap selection: keep a chunk only if its rung matches the rung chosen
        // by distance from the camera to the chunk's own centre. baseCell == G/2 is
        // invariant across rungs, so the band is a pure function of distance; nested
        // rungs in a column derive different bands and exactly one survives per
        // region (no overlap, no holes). Clamping keeps the finest rung (0)
        // near the camera and the coarsest rung far away.
        float baseCell = cellSize / exp2(float(max(entryLevel, 0)));
        vec3  center   = base + 0.5f * cellSize;
        float band = distance(pc.camPos, center) / (baseCell * pc.lodBias);
        selectedLevel = uint(floor(band));
        selectedLevel = uint(min(float(selectedLevel), float(maxLevel)));
        selectedLevel = uint(max(float(selectedLevel), 0.0f));
        selectedLevel = uint(min(float(selectedLevel), float(pc.maxTargetLod)));
    }

    // Publish the chosen level for this draw entry so external consumers
    // (shadow cascade cull, cubemap capture, backface pass) read the exact
    // same selection. Written for EVERY non-empty entry — including ones the
    // LoD band below rejects — so the shadow cascade cull can mirror the exact
    // keep/reject decision via (visibleLods.y == entryLevel). Without this, a
    // rejected level-0 entry keeps the per-frame fill value 0, which the
    // cascade shader cannot tell apart from a *kept* level-0 entry (also 0),
    // causing far chunks to cast finest-mesh shadows the main pass never draws.
    if (s < visibleLods.data.length()) {
        visibleLods.data[s] = uvec2(inCmds.cmds[s].firstInstance, selectedLevel);
    }

    // ── LoD band gate ────────────────────────────────────────────────────────
    // Keep a chunk iff its rung matches the distance-selected rung
    // (entryLevel == selectedLevel). Because selection uses the chunk's own centre,
    // exactly one rung is drawn per region; without this gate every rung of the
    // ladder is drawn at once and coarse rungs smear over the fine detail. Entries
    // with no LoD data (cellSize <= 0) fall through and are kept (legacy behavior).
    if (cellSize > 0.0 && uint(entryLevel) != selectedLevel) {
        return;
    }

    // Models are identity now; frustum planes already extracted into gPlanes.
    if (!aabbVisible(gPlanes, minp, maxp)) return;

    uint dst = atomicAdd(count, 1);
    // Keep the original solid draw index (s) for identification (models are identity)
    if (dst < outCmds.cmds.length()) {
        DrawCmd cmd = inCmds.cmds[s];
        cmd.firstInstance = s;
        outCmds.cmds[dst] = cmd;
    }

    // Chunk is visible — also emit its vegetation (same AABB, step 4).
    processVegetation(s);
}

// ── Cascade (shadow) culling ───────────────────────────────────────────────────
void writeCascade(uint c, DrawCmd cmd) {
    uint dst;
    if (c == 0u) {
        dst = atomicAdd(cc0.count, 1u);
        if (dst < outCasc0.cmds.length()) outCasc0.cmds[dst] = cmd;
    } else if (c == 1u) {
        dst = atomicAdd(cc1.count, 1u);
        if (dst < outCasc1.cmds.length()) outCasc1.cmds[dst] = cmd;
    } else {
        dst = atomicAdd(cc2.count, 1u);
        if (dst < outCasc2.cmds.length()) outCasc2.cmds[dst] = cmd;
    }
}

bool aabbVisibleCascade(uint c, vec3 minp, vec3 maxp) {
    mat4 mvp = cascades.viewProj[c];
    vec4 row0 = vec4(mvp[0][0], mvp[1][0], mvp[2][0], mvp[3][0]);
    vec4 row1 = vec4(mvp[0][1], mvp[1][1], mvp[2][1], mvp[3][1]);
    vec4 row2 = vec4(mvp[0][2], mvp[1][2], mvp[2][2], mvp[3][2]);
    vec4 row3 = vec4(mvp[0][3], mvp[1][3], mvp[2][3], mvp[3][3]);
    vec4 p0 = normalizePlane(row3 + row0);
    vec4 p1 = normalizePlane(row3 - row0);
    vec4 p2 = normalizePlane(row3 + row1);
    vec4 p3 = normalizePlane(row3 - row1);
    vec4 p4 = normalizePlane(row2);
    vec4 p5 = normalizePlane(row3 - row2);
    vec4 planes[6] = vec4[6](p0, p1, p2, p3, p4, p5);
    for (int i = 0; i < 6; ++i) {
        vec3 n = planes[i].xyz;
        float d = planes[i].w;
        vec3 p;
        p.x = (n.x >= 0.0) ? maxp.x : minp.x;
        p.y = (n.y >= 0.0) ? maxp.y : minp.y;
        p.z = (n.z >= 0.0) ? maxp.z : minp.z;
        if (dot(n, p) + d < 0.0) return false;
    }
    return true;
}

// Cull one draw entry against the 3 cascade frustums and append it to the
// cascade stream(s) it is visible in. Mirrors cascade_cull.comp: the LoD guard
// reuses the exact level the main pass stamped into visibleLods (single source of
// truth), so shadows render at the same LoD as the main pass. Entries without LoD
// meta (cellSize <= 0, e.g. water/vegetation) are always kept.
void processChunkCascade(uint s) {
    if (s >= inCmds.cmds.length()) return;
    if (inCmds.cmds[s].indexCount == 0u) return;

    uint bIndex = s * 4u;
    vec3 minp = vec3(0.0);
    vec3 maxp = vec3(0.0);
    if ((bIndex + 2u) >= boundsBuf.data.length()) {
        // No bounds: write to every cascade (legacy behavior).
        DrawCmd cmd = inCmds.cmds[s];
        cmd.firstInstance = s;
        writeCascade(0u, cmd);
        writeCascade(1u, cmd);
        writeCascade(2u, cmd);
        return;
    }
    minp = boundsBuf.data[bIndex].xyz;
    maxp = boundsBuf.data[bIndex + 1u].xyz;

    vec4 lodMeta = boundsBuf.data[bIndex + 2u];
    float cellSize = lodMeta.x;
    uint entryLevel = uint(lodMeta.y + 0.5);
    uint maxLevel   = uint(lodMeta.z + 0.5);
    if (cellSize > 0.0) {
        uint selectedLevel = (s < visibleLods.data.length()) ? visibleLods.data[s].y : 0xFFFFFFFFu;
        bool keep = (selectedLevel == 0xFFFFFFFFu) || (maxLevel == 0u) || (selectedLevel == entryLevel);
        if (!keep) return;
    }

    DrawCmd cmd = inCmds.cmds[s];
    cmd.firstInstance = s;
    if (aabbVisibleCascade(0u, minp, maxp)) writeCascade(0u, cmd);
    if (aabbVisibleCascade(1u, minp, maxp)) writeCascade(1u, cmd);
    if (aabbVisibleCascade(2u, minp, maxp)) writeCascade(2u, cmd);
}

// Vegetation cascade cull: one invocation per veg CHUNK (not per solid draw
// entry). Mirrors the retired veg_cascade_cull.comp — emits two command streams
// per cascade (billboards indexCount=36, impostors indexCount=6) keyed by the
// chunk's instance count + firstInstance.
void processVegCascade(uint idx) {
    if (idx >= pc.vegChunkCount) return;
    uint bIndex = idx * 3u;
    if ((bIndex + 2u) >= vegCascadeInfo.data.length()) return;
    vec3 minp = vegCascadeInfo.data[bIndex].xyz;
    vec3 maxp = vegCascadeInfo.data[bIndex + 1u].xyz;
    vec4 meta = vegCascadeInfo.data[bIndex + 2u];
    if (meta.x < 1.0) return; // empty chunk never draws

    DrawCmd bbCmd;
    bbCmd.indexCount    = 36u;
    bbCmd.instanceCount = uint(meta.x);
    bbCmd.firstIndex    = 0u;
    bbCmd.vertexOffset  = 0;
    bbCmd.firstInstance = uint(meta.y);

    DrawCmd impCmd = bbCmd;
    impCmd.indexCount = 6u;

    if (aabbVisibleCascade(0u, minp, maxp)) {
        uint dst = atomicAdd(vegBbCascCnt0.count, 1u);
        if (dst < vegBbCasc0.cmds.length()) vegBbCasc0.cmds[dst] = bbCmd;
        dst = atomicAdd(vegImpCascCnt0.count, 1u);
        if (dst < vegImpCasc0.cmds.length()) vegImpCasc0.cmds[dst] = impCmd;
    }
    if (aabbVisibleCascade(1u, minp, maxp)) {
        uint dst = atomicAdd(vegBbCascCnt1.count, 1u);
        if (dst < vegBbCasc1.cmds.length()) vegBbCasc1.cmds[dst] = bbCmd;
        dst = atomicAdd(vegImpCascCnt1.count, 1u);
        if (dst < vegImpCasc1.cmds.length()) vegImpCasc1.cmds[dst] = impCmd;
    }
    if (aabbVisibleCascade(2u, minp, maxp)) {
        uint dst = atomicAdd(vegBbCascCnt2.count, 1u);
        if (dst < vegBbCasc2.cmds.length()) vegBbCasc2.cmds[dst] = bbCmd;
        dst = atomicAdd(vegImpCascCnt2.count, 1u);
        if (dst < vegImpCasc2.cmds.length()) vegImpCasc2.cmds[dst] = impCmd;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Extract and normalize the frustum planes once per workgroup from the
    // viewProj push constant. All threads must reach the barrier, so this runs
    // before any early return below.
    if (gl_LocalInvocationIndex < 6u) {
        mat4 mvp = pc.viewProj; // models are identity in this pipeline
        // Extract rows: GLSL `mat4` is column-major, so mvp[i] returns a column.
        vec4 row0 = vec4(mvp[0][0], mvp[1][0], mvp[2][0], mvp[3][0]);
        vec4 row1 = vec4(mvp[0][1], mvp[1][1], mvp[2][1], mvp[3][1]);
        vec4 row2 = vec4(mvp[0][2], mvp[1][2], mvp[2][2], mvp[3][2]);
        vec4 row3 = vec4(mvp[0][3], mvp[1][3], mvp[2][3], mvp[3][3]);

        // Planes: left, right, bottom, top, near, far
        vec4 p;
        if (gl_LocalInvocationIndex == 0u)      
            p = normalizePlane(row3 + row0); // left
        else if (gl_LocalInvocationIndex == 1u) 
            p = normalizePlane(row3 - row0); // right
        else if (gl_LocalInvocationIndex == 2u) 
            p = normalizePlane(row3 + row1); // bottom
        else if (gl_LocalInvocationIndex == 3u) 
            p = normalizePlane(row3 - row1); // top
        else if (gl_LocalInvocationIndex == 4u) 
            p = normalizePlane(row2);        // near (Vulkan NDC z in [0,w])
        else                                   
            p = normalizePlane(row3 - row2);  // far
        gPlanes[gl_LocalInvocationIndex] = p;
    }
    barrier();

    // One invocation per draw entry.
    uint s = idx;
    if (pc.doMain == 1u && s < pc.numCmds) {
        processChunk(s);
    }
    if (pc.doCascade == 1u && s < pc.cascadeEntryCount) {
        processChunkCascade(s);
    }
    if (pc.doVegCascade == 1u && s < pc.vegChunkCount) {
        processVegCascade(s);
    }
}
