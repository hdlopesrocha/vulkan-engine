#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

// Solid input draw commands (one per terrain chunk entry, indexed 0..numCmds-1).
layout(std430, binding = 0) readonly buffer InCmds {
    DrawCmd cmds[];
} inCmds;

// Compacted SOLID output draw commands (frustum + LoD culled).
layout(std430, binding = 1) writeonly buffer OutCmds {
    DrawCmd cmds[];
} outCmds;

// Solid per-entry bounds + LoD meta (vec4 triples, indexed 0..numCmds-1):
//   min, max, lodMeta{cellSize, level, maxLevel, unused}.
// cellSize <= 0 marks an entry with no LoD data (always kept).
layout(std430, binding = 2) readonly buffer Bounds {
    vec4 data[];
} boundsBuf;

// Solid visible (compacted) count.
layout(std430, binding = 3) buffer VisibleCount {
    uint count;
};

// Chosen-LoD output, one uvec2 per SOLID draw entry: {drawIndex, selectedLevel}.
// selectedLevel == 0xFFFFFFFF marks an entry with no LoD data.
layout(std430, binding = 4) writeonly buffer VisibleLods {
    uvec2 data[];
} visibleLods;

// ── Vegetation outputs ───────────────────────────────────────────────────────
// Emitted by processVegetation() for every VISIBLE solid chunk that carries
// vegetation. We reuse the solid chunk's AABB (boundsBuf[s]), so vegetation is
// implicitly culled by the same frustum test as its terrain chunk (step 4: the
// vegetation bounding box IS the solid terrain chunk AABB). Billboards use
// indexCount=36, impostors indexCount=6 — each into its own compact stream.
layout(std430, binding = 5) writeonly buffer OutVegImpCmds {
    DrawCmd cmds[];
} outVegImp;
layout(std430, binding = 6) buffer VegImpCount {
    uint count;
} vegImpCount;

// Vegetation billboard output stream (indexCount=36) + its count.
layout(std430, binding = 7) writeonly buffer OutVegBbCmds {
    DrawCmd cmds[];
} outVegBb;
layout(std430, binding = 8) buffer VegBbCount {
    uint count;
} vegBbCount;

// Per-solid-chunk vegetation table (indexed by the SAME draw index s as the
// solid entry): {instanceCount, firstInstance, pad, pad}. instanceCount < 1
// means the chunk has no vegetation. Binding 9.
layout(std430, binding = 9) readonly buffer VegChunkInfo {
    vec4 data[];
} vegChunkInfo;

layout(push_constant) uniform PC {
    mat4 viewProj;
    uint targetLayer; // 0 = LAYER_OPAQUE, 1 = LAYER_TRANSPARENT (unused for now)
    uint numCmds;     // number of SOLID draw commands
    vec3 camPos;      // camera position driving the per-chunk LoD band selection
    float lodBias;    // band scale: larger = coarser levels kick in farther away
    uint maxTargetLod; // clamp: never select a coarser LoD level than this
    uint numCmdsVeg;   // legacy/unused in the merged dispatch (kept for layout compatibility)
} pc;

// Shared, per-workgroup cache of the six frustum planes. The viewProj matrix is
// a push constant identical for every invocation of a dispatch, so extracting and
// normalizing the planes once per workgroup (instead of once per invocation) avoids
// thousands of redundant length()/divide ALU ops per frame.
shared vec4 gPlanes[6];

// Normalize a frustum plane (n, d) by its normal length so the distance test is
// stable. Length is never zero for a valid view-projection matrix.
vec4 normalizePlane(vec4 pl) {
    float len = length(pl.xyz);
    return pl / max(len, 1e-8);
}

// Robust AABB vs frustum test. `planes` already holds the normalized clip-space
// planes (left, right, bottom, top, near, far). Normalization keeps the distance
// test stable and avoids false negatives when the camera is inside the AABB.
bool aabbVisible(vec4 planes[6], vec3 minp, vec3 maxp) {
    // For each plane, test the AABB's most positive (closest) vertex
    for (int i = 0; i < 6; ++i) {
        vec3 n = planes[i].xyz;
        float d = planes[i].w;

        vec3 p;
        p.x = (n.x >= 0.0) ? maxp.x : minp.x;
        p.y = (n.y >= 0.0) ? maxp.y : minp.y;
        p.z = (n.z >= 0.0) ? maxp.z : minp.z;
        float dist = dot(n, p) + d;
        if (dist < 0.0) {
            // AABB is completely outside this plane
            return false;
        }
    }

    // Passed all plane tests => box intersects or is inside frustum
    return true;
}

// Emit the billboard (indexCount=36) and impostor (indexCount=6) draw commands
// for a solid chunk that survived culling. Called from processChunk once the
// chunk is known visible, so no extra AABB test is needed — vegetation shares
// the terrain chunk's bounding box.
void processVegetation(uint s) {
    if (s >= vegChunkInfo.data.length()) return;
    vec4 meta = vegChunkInfo.data[s];
    if (meta.x < 1.0) return; // no vegetation in this chunk

    uint instanceCount = uint(meta.x);
    uint firstInstance  = uint(meta.y);

    DrawCmd bbCmd;
    bbCmd.indexCount    = 36u;
    bbCmd.instanceCount = instanceCount;
    bbCmd.firstIndex    = 0u;
    bbCmd.vertexOffset  = 0;
    bbCmd.firstInstance = firstInstance;
    uint dstB = atomicAdd(vegBbCount.count, 1u);
    if (dstB < outVegBb.cmds.length()) outVegBb.cmds[dstB] = bbCmd;

    DrawCmd impCmd = bbCmd;
    impCmd.indexCount = 6u;
    uint dstI = atomicAdd(vegImpCount.count, 1u);
    if (dstI < outVegImp.cmds.length()) outVegImp.cmds[dstI] = impCmd;
}

// Cull one solid terrain chunk (frustum + per-chunk LoD band) and emit its
// compacted solid command. If the chunk is kept, its vegetation is emitted too
// via processVegetation (so vegetation is drawn exactly for the visible chunks).
void processChunk(uint s) {
    if (s >= inCmds.cmds.length() || s >= pc.numCmds) return;

    // Empty entries (no mesh data) never draw, never count, and carry no vegetation.
    if (inCmds.cmds[s].indexCount == 0u) return;

    // bounds stored as min, max, meta triples in `boundsBuf.data`
    // meta = {cellSize, level, maxLevel, unused}: cellSize is the chunk's
    // OWN cube length (frontier base = cellSize / 2^level), level is the
    // 0-based LoD level. cellSize <= 0 marks an entry with no LoD data
    // (always kept, legacy behavior).
    uint bIndex = s * 3u;
    bool hasBounds = (bIndex + 2u) < boundsBuf.data.length();
    vec3 minp = vec3(0.0);
    vec3 maxp = vec3(0.0);
    vec4 lodMeta = vec4(0.0);
    if (hasBounds) {
        minp = boundsBuf.data[bIndex].xyz;
        maxp = boundsBuf.data[bIndex + 1u].xyz;
        lodMeta = boundsBuf.data[bIndex + 2u];
    }

    // ── Per-chunk LoD band selection (frustum-independent) ──────────────────
    // Chunks arrive one by one, each a single mesh tagged with its own
    // chunkLod level. Every chunk covers a band of distance:
    //   band = dist(camPos, anchor) / (baseCell * lodBias)
    // with baseCell = cellSize / 2^level (the frontier cell size) and anchor
    // the center of the chunk's LoD-PYRAMID root cube, so the bands of the
    // pyramid TILE distance: level k covers band [k, k+1), and the coarsest
    // level (== meta.z) covers everything beyond. The chunk is kept iff its
    // level matches the band — close chunks draw the fine frontier meshes,
    // far chunks the coarse ancestor meshes.
    //
    // The band must be anchored at the pyramid root cube (shared by every
    // level of the pyramid), NOT at the chunk's own center: each level's
    // cube center is offset along the pyramid diagonal (a level-k center is
    // a corner of its level-(k-1) children), so distance-to-center gives each
    // level a slightly different band and the bands stop tiling — gap shells
    // where no level of the pyramid matches (chunks missing from view) and
    // overlaps where two levels match. The root cube side is
    // cellSize * 2^(maxLevel - entryLevel), and its min corner is the
    // grid-aligned floor of the chunk's AABB min, which is shared by every
    // level of the pyramid — so all levels derive the exact same anchor and
    // floor(band) selects exactly one level per region.
    //
    // The selection is computed for EVERY non-empty entry — even ones outside
    // the camera frustum — and stamped into visibleLods, so the shadow cascade
    // cull reads the exact same level instead of re-deriving the band with a
    // stale camera position. (The band depends only on distance to the camera,
    // not on the frustum.)
    float cellSize = lodMeta.x;
    int entryLevel = int(lodMeta.y + 0.5);
    int maxLevel   = int(lodMeta.z + 0.5);

    uint selectedLevel = 0xFFFFFFFFu;
    if (cellSize > 0.0) {
        float baseCell = cellSize / exp2(float(max(entryLevel, 0)));
        float rootSide = cellSize * exp2(float(maxLevel - entryLevel));
        vec3 rootMin = floor(minp / rootSide) * rootSide;
        vec3 anchor = rootMin + 0.5 * rootSide;
        float band = distance(pc.camPos, anchor) / (baseCell * pc.lodBias);
        selectedLevel = uint(min(floor(band), float(maxLevel)));
        // Clamp the chosen level so the renderer never picks a coarser LoD than
        // the user-configured ceiling (settings.maxTargetLod). 0xFFFFFFFF stays
        // untouched for entries with no LoD data.
        selectedLevel = uint(min(float(selectedLevel), float(pc.maxTargetLod)));
    }

    // Publish the chosen level for this draw entry so external consumers
    // (shadow cascade cull, cubemap capture, backface pass) read the exact
    // same selection. Written for EVERY non-empty entry — including ones the
    // LoD band below rejects — so the shadow cascade cull can mirror the exact
    // keep/reject decision via (visibleLods.y == entryLevel). Without this, a
    // rejected level-0 entry keeps the per-frame fill value 0, which the
    // cascade shader cannot tell apart from a *kept* level-0 entry (also 0),
    // causing far chunks to cast finest-mesh shadows the main pass never draws.
    if (s < visibleLods.data.length()) {
        visibleLods.data[s] = uvec2(inCmds.cmds[s].firstInstance, selectedLevel);
    }

    // ── LoD band gate ────────────────────────────────────────────────────────
    // "The chunk is kept iff its level matches the band" (see note above). The
    // band selects exactly one level per location; without this gate EVERY rung
    // of the clipmap ladder is drawn simultaneously, so coarse rungs smear over
    // the fine detail and the surface looks blobby. Entries carrying no LoD data
    // (cellSize <= 0) are always kept (legacy behavior).
    if (cellSize > 0.0 && uint(entryLevel) != selectedLevel) {
        return;
    }

    // Models are identity now; frustum planes already extracted into gPlanes.
    if (!aabbVisible(gPlanes, minp, maxp)) return;

    uint dst = atomicAdd(count, 1);
    // Keep the original solid draw index (s) for identification (models are identity)
    if (dst < outCmds.cmds.length()) {
        DrawCmd cmd = inCmds.cmds[s];
        cmd.firstInstance = s;
        outCmds.cmds[dst] = cmd;
    }

    // Chunk is visible — also emit its vegetation (same AABB, step 4).
    processVegetation(s);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Extract and normalize the frustum planes once per workgroup from the
    // viewProj push constant. All threads must reach the barrier, so this runs
    // before any early return below.
    if (gl_LocalInvocationIndex < 6u) {
        mat4 mvp = pc.viewProj; // models are identity in this pipeline
        // Extract rows: GLSL `mat4` is column-major, so mvp[i] returns a column.
        vec4 row0 = vec4(mvp[0][0], mvp[1][0], mvp[2][0], mvp[3][0]);
        vec4 row1 = vec4(mvp[0][1], mvp[1][1], mvp[2][1], mvp[3][1]);
        vec4 row2 = vec4(mvp[0][2], mvp[1][2], mvp[2][2], mvp[3][2]);
        vec4 row3 = vec4(mvp[0][3], mvp[1][3], mvp[2][3], mvp[3][3]);

        // Planes: left, right, bottom, top, near, far
        vec4 p;
        if (gl_LocalInvocationIndex == 0u)      
            p = normalizePlane(row3 + row0); // left
        else if (gl_LocalInvocationIndex == 1u) 
            p = normalizePlane(row3 - row0); // right
        else if (gl_LocalInvocationIndex == 2u) 
            p = normalizePlane(row3 + row1); // bottom
        else if (gl_LocalInvocationIndex == 3u) 
            p = normalizePlane(row3 - row1); // top
        else if (gl_LocalInvocationIndex == 4u) 
            p = normalizePlane(row2);        // near (Vulkan NDC z in [0,w])
        else                                   
            p = normalizePlane(row3 - row2);  // far
        gPlanes[gl_LocalInvocationIndex] = p;
    }
    barrier();

    // One invocation per solid chunk entry; vegetation is handled inside
    // processChunk once the chunk is known visible.
    uint s = idx;
    if (s >= pc.numCmds) return;
    processChunk(s);
}
