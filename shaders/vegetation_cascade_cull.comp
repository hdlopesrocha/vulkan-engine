#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ChunkMeta {
    vec3 aabbMin;
    float pad0;
    vec3 aabbMax;
    float pad1;
    uint instanceOffset;
    uint instanceCount;
};

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, binding = 0) readonly buffer Meta {
    ChunkMeta chunks[];
} metaBuf;

layout(std430, binding = 1) writeonly buffer OutCmds0 {
    DrawCmd cmds[];
} outCmds0;

layout(std430, binding = 2) buffer Count0 {
    uint count;
} cnt0;

layout(std430, binding = 3) writeonly buffer OutCmds1 {
    DrawCmd cmds[];
} outCmds1;

layout(std430, binding = 4) buffer Count1 {
    uint count;
} cnt1;

layout(std430, binding = 5) writeonly buffer OutCmds2 {
    DrawCmd cmds[];
} outCmds2;

layout(std430, binding = 6) buffer Count2 {
    uint count;
} cnt2;

layout(std430, binding = 7) readonly buffer CascadeMatrices {
    mat4 viewProj[3]; // [0] = C0 (inner), [1] = C1, [2] = C2 (outer)
} cascades;

layout(push_constant) uniform PC {
    uint numChunks;
} pc;

shared vec4 gPlanes[3][6];

vec4 normalizePlane(vec4 pl) {
    float len = length(pl.xyz);
    return pl / max(len, 1e-8);
}

void extractPlanes(mat4 mvp, out vec4 planes[6]) {
    vec4 row0 = vec4(mvp[0][0], mvp[1][0], mvp[2][0], mvp[3][0]);
    vec4 row1 = vec4(mvp[0][1], mvp[1][1], mvp[2][1], mvp[3][1]);
    vec4 row2 = vec4(mvp[0][2], mvp[1][2], mvp[2][2], mvp[3][2]);
    vec4 row3 = vec4(mvp[0][3], mvp[1][3], mvp[2][3], mvp[3][3]);

    planes[0] = normalizePlane(row3 + row0); // left
    planes[1] = normalizePlane(row3 - row0); // right
    planes[2] = normalizePlane(row3 + row1); // bottom
    planes[3] = normalizePlane(row3 - row1); // top
    planes[4] = normalizePlane(row2);        // near
    planes[5] = normalizePlane(row3 - row2); // far
}

bool aabbVisible(vec4 planes[6], vec3 minp, vec3 maxp) {
    for (int i = 0; i < 6; ++i) {
        vec3 n = planes[i].xyz;
        float d = planes[i].w;
        vec3 p;
        p.x = (n.x >= 0.0) ? maxp.x : minp.x;
        p.y = (n.y >= 0.0) ? maxp.y : minp.y;
        p.z = (n.z >= 0.0) ? maxp.z : minp.z;
        float dist = dot(n, p) + d;
        if (dist < 0.0) return false;
    }
    return true;
}

void writeToCascade(uint cascade, DrawCmd cmd, uint idx) {
    uint dst = 0u;
    if (cascade == 0u) {
        dst = atomicAdd(cnt0.count, 1);
        if (dst < outCmds0.cmds.length()) outCmds0.cmds[dst] = cmd;
    } else if (cascade == 1u) {
        dst = atomicAdd(cnt1.count, 1);
        if (dst < outCmds1.cmds.length()) outCmds1.cmds[dst] = cmd;
    } else {
        dst = atomicAdd(cnt2.count, 1);
        if (dst < outCmds2.cmds.length()) outCmds2.cmds[dst] = cmd;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (gl_LocalInvocationIndex < 18u) {
        uint c = gl_LocalInvocationIndex / 6u;
        uint p = gl_LocalInvocationIndex % 6u;
        vec4 planes[6];
        extractPlanes(cascades.viewProj[c], planes);
        gPlanes[c][p] = planes[p];
    }
    barrier();

    if (idx >= pc.numChunks || idx >= metaBuf.chunks.length()) return;

    ChunkMeta chunk = metaBuf.chunks[idx];

    DrawCmd cmd;
    cmd.indexCount = 36;
    cmd.instanceCount = chunk.instanceCount;
    cmd.firstIndex = 0;
    cmd.vertexOffset = 0;
    cmd.firstInstance = chunk.instanceOffset;

    // Independent per-cascade culling: a chunk is drawn to a cascade iff it
    // is visible in that cascade's frustum.  No exclusion between cascades.
    if (aabbVisible(gPlanes[0], chunk.aabbMin, chunk.aabbMax)) writeToCascade(0u, cmd, idx);
    if (aabbVisible(gPlanes[1], chunk.aabbMin, chunk.aabbMax)) writeToCascade(1u, cmd, idx);
    if (aabbVisible(gPlanes[2], chunk.aabbMin, chunk.aabbMax)) writeToCascade(2u, cmd, idx);
}