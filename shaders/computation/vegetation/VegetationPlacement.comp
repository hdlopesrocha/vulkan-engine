#version 450
#extension GL_EXT_scalar_block_layout : enable

// GPU vegetation placement from the renderer's GPU-resident chunk mesh.
//
// Since the octree topology pass writes the Cartesian vertices + index stream
// straight into the solid IndirectRenderer's packed pools (OctreeTriangles.comp
// — see services/OctreeTopologyCompute), no chunk geometry ever reaches the
// host. This dispatch reads that chunk's pool span directly, expands the
// grass-touching triangles into area-weighted virtual slots (the same
// stochastic-rounding rule as utils/GrassPlacement::collectSlots, with a
// deterministic per-triangle hash replacing the CPU mt19937), places every
// slot (barycentric sample, dominant-vertex brush test, biome gate,
// variant/rotation) and writes the 32-byte instance records straight into the
// chunk's device-local instance buffer. Only the resulting count is read back,
// after the dispatch fence, to publish the chunk.

layout(local_size_x = 64) in;

// Chunk span of the solid packed vertex pool (64-byte Vertex stride, bound as
// 4 x vec4):
//   vec4[0] position.xyz | color.x
//   vec4[1] color.yz | texCoord.xy
//   vec4[2] normal.xyz | brushIndex bits
//   vec4[3] textureType | hsv
layout(set = 0, binding = 0, scalar) readonly buffer InVerts { vec4 verts[]; };
// Chunk-local index stream; values are vertex-slot indices in the same span.
layout(set = 0, binding = 1, scalar) readonly buffer InIdx   { uint indices[]; };
// Output: 2x vec4 per instance (pos vec4, then normal vec4) = kInstanceStride.
layout(set = 0, binding = 2, scalar) writeonly buffer OutInst { vec4 instances[]; };
layout(set = 0, binding = 3, scalar) buffer Counter { uint count; };

layout(push_constant, scalar) uniform PC {
    uint triangleCount;
    uint seed;
    uint billboardCount;
    int  grassBrush;
    uint vertexCount;
    uint relVertexBase;   // first pool element inside the bound vertex window
    uint relIndexBase;    // first index inside the bound index window
    uint instanceCapacity;
    float density;        // instances per world-space unit of triangle area
} pc;

uint xorshift32(inout uint state) {
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return state;
}

float randFloat(inout uint state) {
    return float(xorshift32(state) & 0x00FFFFFFu) / float(0x01000000u);
}

// Position hash — matches posHash in utils/GrassPlacement.cpp.
uint posHash(vec3 p) {
    ivec3 qi = ivec3(round(p * 8.0));
    uint h = uint(qi.x) * 1640531513u;
    h ^= uint(qi.y) * 2246822519u;
    h ^= uint(qi.z) * 3266489917u;
    return h;
}

// 2D cell hash — matches cellHash in utils/GrassPlacement.cpp.
uint cellHash(ivec2 c) {
    uint h = uint(c.x) * 1640531513u ^ uint(c.y) * 2246822519u;
    h ^= h >> 13;
    h *= 0x45d9f3bu;
    h ^= h >> 16;
    return h;
}

// Biome noise — matches biomeNoise in utils/GrassPlacement.cpp.
float biomeNoise(vec2 xz) {
    const float kBiomeScale = 50.0;
    vec2 p = xz / kBiomeScale;
    ivec2 i = ivec2(floor(p));
    vec2 f = p - vec2(i);
    vec2 u = f * f * (3.0 - 2.0 * f);

    float a = float(cellHash(i + ivec2(0, 0))) / 4294967295.0;
    float b = float(cellHash(i + ivec2(1, 0))) / 4294967295.0;
    float c = float(cellHash(i + ivec2(0, 1))) / 4294967295.0;
    float d = float(cellHash(i + ivec2(1, 1))) / 4294967295.0;

    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

vec3 vertexPos(uint i) {
    return verts[(pc.relVertexBase + i) * 4u + 0u].xyz;
}

vec3 vertexNormal(uint i) {
    return verts[(pc.relVertexBase + i) * 4u + 2u].xyz;
}

int vertexBrush(uint i) {
    return floatBitsToInt(verts[(pc.relVertexBase + i) * 4u + 2u].w);
}

void emitInstance(vec3 v0, vec3 v1, vec3 v2,
                  vec3 n0, vec3 n1, vec3 n2,
                  int b0, int b1, int b2,
                  uint tri, uint slot, uint tch) {
    uint rng = pc.seed ^ tch ^ (tri * 2654435761u) ^ (slot * 19349663u);
    float u = randFloat(rng);
    float v = randFloat(rng);
    if (u + v > 1.0) { u = 1.0 - u; v = 1.0 - v; }
    float w = 1.0 - u - v;
    vec3 pos = u * v0 + v * v1 + w * v2;

    // Dominant-vertex brush test: keep the sample only if the closest vertex
    // (largest barycentric weight) is grass-brushed (mirrors the CPU path).
    int dominantBrush = (u >= v && u >= w) ? b0
                      : (v >= w)          ? b1
                                          : b2;
    if (dominantBrush != pc.grassBrush) return;

    // Biome from spatially-coherent noise.
    float noise = biomeNoise(pos.xz);
    if (noise < 0.40) return; // empty biome — skip entirely

    float remapped = (noise - 0.40) / 0.60;
    uint bi = min(uint(remapped * float(pc.billboardCount)), pc.billboardCount - 1u);

    uint rs = pc.seed ^ posHash(pos);
    float rf = randFloat(rs);

    // Smooth surface normal (barycentric interpolation).
    vec3 nrm = u * n0 + v * n1 + w * n2;
    float nlen2 = dot(nrm, nrm);
    nrm = (nlen2 > 1e-8) ? nrm * inversesqrt(nlen2) : vec3(0.0, 1.0, 0.0);

    uint outIdx = atomicAdd(count, 1u);
    if (outIdx >= pc.instanceCapacity) return;
    instances[outIdx * 2u + 0u] = vec4(pos, float(bi) + rf);
    instances[outIdx * 2u + 1u] = vec4(nrm, 0.0);
}

void main() {
    uint tri = gl_GlobalInvocationID.x;
    if (tri >= pc.triangleCount) return;

    uint ib = pc.relIndexBase + tri * 3u;
    uint i0 = indices[ib + 0u];
    uint i1 = indices[ib + 1u];
    uint i2 = indices[ib + 2u];
    if (i0 >= pc.vertexCount || i1 >= pc.vertexCount || i2 >= pc.vertexCount) return;

    vec3 v0 = vertexPos(i0);
    vec3 v1 = vertexPos(i1);
    vec3 v2 = vertexPos(i2);
    vec3 vn0 = vertexNormal(i0);
    vec3 vn1 = vertexNormal(i1);
    vec3 vn2 = vertexNormal(i2);
    int b0 = vertexBrush(i0);
    int b1 = vertexBrush(i1);
    int b2 = vertexBrush(i2);

    // Permissive: any grass-touching triangle contributes slots; the
    // per-instance dominant-vertex test trims the spill later.
    bool hasBrush = (b0 == pc.grassBrush) || (b1 == pc.grassBrush) || (b2 == pc.grassBrush);
    if (!hasBrush) return;

    vec3 faceNormal = cross(v1 - v0, v2 - v0);
    float area = 0.5 * length(faceNormal);
    float expected = max(0.0, area * pc.density);
    if (!(expected > 0.0)) return;

    uint slots = uint(floor(expected));
    float fractional = expected - float(slots);
    // Deterministic per-triangle replacement for collectSlots' mt19937 draw.
    uint stoch = pc.seed ^ (tri * 0x9e3779b9u) ^ posHash((v0 + v1 + v2) / 3.0);
    if (randFloat(stoch) < fractional) ++slots;
    slots = min(slots, pc.instanceCapacity);

    // A triangle contributes a handful of slots; loop here so no prefix sum /
    // virtual-slot list is needed and no CPU data ever enters the path.
    uint tch = posHash((v0 + v1 + v2) / 3.0);
    for (uint s = 0u; s < slots; ++s) {
        emitInstance(v0, v1, v2, vn0, vn1, vn2, b0, b1, b2, tri, s, tch);
    }
}
