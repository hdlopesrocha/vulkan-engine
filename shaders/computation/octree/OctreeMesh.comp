#version 450
#extension GL_EXT_scalar_block_layout : enable

// GPU surface-vertex extraction, one invocation per cell.
//
// The cell math is NOT implemented here: it comes from
// includes/octree/SdfCell.glsl, the single shared bit-exact port of the CPU
// functions the tessellator uses (SDF::eval, SDF::getPosition,
// SDF::getNormalFromPosition, Math::solveLinearSystem). OctreeTriangles.comp
// includes the same file, so the two GPU consumers can never disagree with each
// other or with the CPU walker.
//
// Every cell emits exactly one vertex at the cell's own index (non-surface
// cells emit their cube centre, exactly like SDF::getPosition), so a consumer
// can index the output by cell without holes.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, scalar) readonly buffer InSdf0 { vec4 sdf0[]; };
layout(set = 0, binding = 1, scalar) readonly buffer InSdf1 { vec4 sdf1[]; };
layout(set = 0, binding = 2, scalar) readonly buffer InCube { vec4 cubeMin[]; }; // xyz=min, w=size
layout(set = 0, binding = 3, scalar) readonly buffer InBrush { int brushIndex[]; };

layout(set = 0, binding = 4, scalar) writeonly buffer OutPositions { vec4 positions[]; };
layout(set = 0, binding = 5, scalar) writeonly buffer OutNormals { vec4 normals[]; };
layout(set = 0, binding = 6) buffer Counters { uint vertexCount; };

layout(push_constant) uniform PC {
    uint cellCount;
    float isoValue; // unused: SDF::getPosition compares against 0 like the CPU
} pc;

#include "../../includes/octree/SdfCell.glsl"

void cellSdf(uint gi, out float sdf[8]) {
    for (int i = 0; i < 4; ++i) {
        sdf[i] = sdf0[gi][i];
        sdf[i + 4] = sdf1[gi][i];
    }
}

void main() {
    uint gi = gl_GlobalInvocationID.x;
    if (gi >= pc.cellCount) return;

    float sdf[8];
    cellSdf(gi, sdf);
    const vec3 mn = cubeMin[gi].xyz;
    const float sz = cubeMin[gi].w;

    const vec3 pos = sdfCellPosition(sdf, mn, sz);
    const vec3 nrm = sdfCellNormal(sdf, mn, sz, pos);

    // One vertex per cell at the cell's own index: the host maps output i back
    // to input cell i (services/OctreeMeshCompute.cpp), so an atomic append
    // would scramble that mapping. The counter is informational only.
    positions[gi] = vec4(pos, uintBitsToFloat(brushIndex[gi]));
    normals[gi] = vec4(nrm, 0.0);
    if (gi == 0u) {
        vertexCount = pc.cellCount;
    }
}
