#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, binding = 0) readonly buffer InCmds {
    DrawCmd cmds[];
} inCmds;

layout(std430, binding = 1) writeonly buffer OutCmds0 {
    DrawCmd cmds[];
} outCmds0;

layout(std430, binding = 2) readonly buffer Bounds {
    vec4 data[];
} boundsBuf;

layout(std430, binding = 3) buffer Count0 {
    uint count;
} cnt0;

layout(std430, binding = 4) writeonly buffer OutCmds1 {
    DrawCmd cmds[];
} outCmds1;

layout(std430, binding = 5) buffer Count1 {
    uint count;
} cnt1;

layout(std430, binding = 6) writeonly buffer OutCmds2 {
    DrawCmd cmds[];
} outCmds2;

layout(std430, binding = 7) buffer Count2 {
    uint count;
} cnt2;

layout(std430, binding = 8) readonly buffer CascadeMatrices {
    mat4 viewProj[3];
} cascades;

layout(push_constant) uniform PC {
    uint numChunks;
    float maxShadowDist;
} pc;

const float BLEND_MARGIN = 0.04;

shared vec4 gPlanes[3][6];

vec4 normalizePlane(vec4 pl) {
    float len = length(pl.xyz);
    return pl / max(len, 1e-8);
}

void extractPlanes(mat4 mvp, out vec4 planes[6]) {
    vec4 row0 = vec4(mvp[0][0], mvp[1][0], mvp[2][0], mvp[3][0]);
    vec4 row1 = vec4(mvp[0][1], mvp[1][1], mvp[2][1], mvp[3][1]);
    vec4 row2 = vec4(mvp[0][2], mvp[1][2], mvp[2][2], mvp[3][2]);
    vec4 row3 = vec4(mvp[0][3], mvp[1][3], mvp[2][3], mvp[3][3]);

    planes[0] = normalizePlane(row3 + row0);
    planes[1] = normalizePlane(row3 - row0);
    planes[2] = normalizePlane(row3 + row1);
    planes[3] = normalizePlane(row3 - row1);
    planes[4] = normalizePlane(row2);
    planes[5] = normalizePlane(row3 - row2);
}

bool aabbVisibleExtruded(uint cascade, vec3 minp, vec3 maxp) {
    for (int i = 0; i < 6; ++i) {
        vec3 n = gPlanes[cascade][i].xyz;
        float d = gPlanes[cascade][i].w;
        if (i == 4) d += pc.maxShadowDist;
        vec3 p;
        p.x = (n.x >= 0.0) ? maxp.x : minp.x;
        p.y = (n.y >= 0.0) ? maxp.y : minp.y;
        p.z = (n.z >= 0.0) ? maxp.z : minp.z;
        float dist = dot(n, p) + d;
        if (dist < 0.0) return false;
    }
    return true;
}

bool aabbProjectedSafe(mat4 mvp, vec3 minp, vec3 maxp, float margin) {
    vec2 uvMin = vec2(1e10);
    vec2 uvMax = vec2(-1e10);
    for (int iz = 0; iz < 2; iz++) {
        for (int iy = 0; iy < 2; iy++) {
            for (int ix = 0; ix < 2; ix++) {
                vec3 p = vec3(
                    (ix == 0) ? minp.x : maxp.x,
                    (iy == 0) ? minp.y : maxp.y,
                    (iz == 0) ? minp.z : maxp.z
                );
                vec4 ls = mvp * vec4(p, 1.0);
                vec2 uv = ls.xy / ls.w * 0.5 + 0.5;
                uvMin = min(uvMin, uv);
                uvMax = max(uvMax, uv);
            }
        }
    }
    return uvMin.x >= margin && uvMax.x <= 1.0 - margin &&
           uvMin.y >= margin && uvMax.y <= 1.0 - margin;
}

void writeToCascade(uint cascade, DrawCmd cmd) {
    uint dst = 0u;
    if (cascade == 0u) {
        dst = atomicAdd(cnt0.count, 1);
        if (dst < outCmds0.cmds.length()) outCmds0.cmds[dst] = cmd;
    } else if (cascade == 1u) {
        dst = atomicAdd(cnt1.count, 1);
        if (dst < outCmds1.cmds.length()) outCmds1.cmds[dst] = cmd;
    } else {
        dst = atomicAdd(cnt2.count, 1);
        if (dst < outCmds2.cmds.length()) outCmds2.cmds[dst] = cmd;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (gl_LocalInvocationIndex < 18u) {
        uint c = gl_LocalInvocationIndex / 6u;
        uint p = gl_LocalInvocationIndex % 6u;
        vec4 planes[6];
        extractPlanes(cascades.viewProj[c], planes);
        gPlanes[c][p] = planes[p];
    }
    barrier();

    if (idx >= pc.numChunks || idx >= inCmds.cmds.length()) return;

    uint bIndex = idx * 2u;
    vec3 minp = vec3(0.0);
    vec3 maxp = vec3(0.0);
    if ((bIndex + 1u) < boundsBuf.data.length()) {
        minp = boundsBuf.data[bIndex].xyz;
        maxp = boundsBuf.data[bIndex + 1u].xyz;
    } else {
        DrawCmd cmd = inCmds.cmds[idx];
        cmd.firstInstance = idx;
        writeToCascade(0u, cmd);
        writeToCascade(1u, cmd);
        writeToCascade(2u, cmd);
        return;
    }

    DrawCmd cmd = inCmds.cmds[idx];
    cmd.firstInstance = idx;

    if (!aabbVisibleExtruded(0, minp, maxp) &&
        !aabbVisibleExtruded(1, minp, maxp) &&
        !aabbVisibleExtruded(2, minp, maxp)) return;

    if (aabbVisibleExtruded(1, minp, maxp)) {
        if (aabbProjectedSafe(cascades.viewProj[1], minp, maxp, BLEND_MARGIN)) {
            if (aabbVisibleExtruded(0, minp, maxp)) {
                if (aabbProjectedSafe(cascades.viewProj[0], minp, maxp, BLEND_MARGIN)) {
                    writeToCascade(0u, cmd);
                } else {
                    writeToCascade(0u, cmd);
                    writeToCascade(1u, cmd);
                }
            } else {
                writeToCascade(1u, cmd);
            }
        } else {
            if (aabbVisibleExtruded(0, minp, maxp)) {
                if (aabbProjectedSafe(cascades.viewProj[0], minp, maxp, BLEND_MARGIN)) {
                    writeToCascade(0u, cmd);
                    writeToCascade(1u, cmd);
                } else {
                    writeToCascade(0u, cmd);
                    writeToCascade(1u, cmd);
                    writeToCascade(2u, cmd);
                }
            } else {
                writeToCascade(1u, cmd);
                writeToCascade(2u, cmd);
            }
        }
    } else if (aabbVisibleExtruded(0, minp, maxp)) {
        writeToCascade(0u, cmd);
    } else {
        writeToCascade(2u, cmd);
    }
}
