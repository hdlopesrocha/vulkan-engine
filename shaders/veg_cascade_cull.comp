#version 450

// Vegetation cascade culling — GPU side. The chunk table (AABBs + instance
// counts + concatenated-buffer offsets) is written by the CPU on
// consolidation; this shader frustum-culls every chunk against all 3 shadow
// cascade frustums and atomically compacts draw commands into per-cascade
// buffers, mirroring the solid renderer's cascade_cull.comp. Outputs TWO
// command streams per cascade: billboards (indexCount=36) and impostors
// (indexCount=6), so both shadow draws use vkCmdDrawIndexedIndirectCount with
// GPU-written counts — no CPU readback of cull results.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, binding = 0) readonly buffer ChunkInfo {
    // vec4 triples per chunk: aabbMin.xyz|pad, aabbMax.xyz|pad,
    // {instanceCount, firstInstance, pad, pad}.
    vec4 data[];
} chunkInfo;

layout(std430, binding = 1) writeonly buffer BillboardCmds0 { DrawCmd cmds[]; } bbCmds0;
layout(std430, binding = 2) buffer BillboardCount0  { uint count; }       bbCnt0;
layout(std430, binding = 3) writeonly buffer BillboardCmds1 { DrawCmd cmds[]; } bbCmds1;
layout(std430, binding = 4) buffer BillboardCount1  { uint count; }       bbCnt1;
layout(std430, binding = 5) writeonly buffer BillboardCmds2 { DrawCmd cmds[]; } bbCmds2;
layout(std430, binding = 6) buffer BillboardCount2  { uint count; }       bbCnt2;

layout(std430, binding = 7) writeonly buffer ImpostorCmds0 { DrawCmd cmds[]; } impCmds0;
layout(std430, binding = 8) buffer ImpostorCount0  { uint count; }       impCnt0;
layout(std430, binding = 9) writeonly buffer ImpostorCmds1 { DrawCmd cmds[]; } impCmds1;
layout(std430, binding = 10) buffer ImpostorCount1  { uint count; }      impCnt1;
layout(std430, binding = 11) writeonly buffer ImpostorCmds2 { DrawCmd cmds[]; } impCmds2;
layout(std430, binding = 12) buffer ImpostorCount2  { uint count; }      impCnt2;

layout(std430, binding = 13) readonly buffer CascadeMatrices {
    mat4 viewProj[3];
} cascades;

layout(push_constant) uniform PC {
    uint numChunks;
} pc;

shared vec4 gPlanes[3][6];

vec4 normalizePlane(vec4 pl) {
    float len = length(pl.xyz);
    return pl / max(len, 1e-8);
}

void extractPlanes(mat4 mvp, out vec4 planes[6]) {
    vec4 row0 = vec4(mvp[0][0], mvp[1][0], mvp[2][0], mvp[3][0]);
    vec4 row1 = vec4(mvp[0][1], mvp[1][1], mvp[2][1], mvp[3][1]);
    vec4 row2 = vec4(mvp[0][2], mvp[1][2], mvp[2][2], mvp[3][2]);
    vec4 row3 = vec4(mvp[0][3], mvp[1][3], mvp[2][3], mvp[3][3]);

    planes[0] = normalizePlane(row3 + row0);
    planes[1] = normalizePlane(row3 - row0);
    planes[2] = normalizePlane(row3 + row1);
    planes[3] = normalizePlane(row3 - row1);
    planes[4] = normalizePlane(row2);
    planes[5] = normalizePlane(row3 - row2);
}

bool aabbVisible(uint cascade, vec3 minp, vec3 maxp) {
    for (int i = 0; i < 6; ++i) {
        vec3 n = gPlanes[cascade][i].xyz;
        float d = gPlanes[cascade][i].w;
        vec3 p;
        p.x = (n.x >= 0.0) ? maxp.x : minp.x;
        p.y = (n.y >= 0.0) ? maxp.y : minp.y;
        p.z = (n.z >= 0.0) ? maxp.z : minp.z;
        float dist = dot(n, p) + d;
        if (dist < 0.0) return false;
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (gl_LocalInvocationIndex < 18u) {
        uint c = gl_LocalInvocationIndex / 6u;
        uint p = gl_LocalInvocationIndex % 6u;
        vec4 planes[6];
        extractPlanes(cascades.viewProj[c], planes);
        gPlanes[c][p] = planes[p];
    }
    barrier();

    if (idx >= pc.numChunks) return;
    uint bIndex = idx * 3u;
    if ((bIndex + 2u) >= chunkInfo.data.length()) return;

    vec3 minp = chunkInfo.data[bIndex].xyz;
    vec3 maxp = chunkInfo.data[bIndex + 1u].xyz;
    vec4 meta = chunkInfo.data[bIndex + 2u];

    // Empty entries (instanceCount == 0) never draw and never count.
    if (meta.x < 1.0) return;

    DrawCmd bbCmd;
    bbCmd.indexCount    = 36u;
    bbCmd.instanceCount = uint(meta.x);
    bbCmd.firstIndex    = 0u;
    bbCmd.vertexOffset  = 0;
    bbCmd.firstInstance = uint(meta.y);

    DrawCmd impCmd = bbCmd;
    impCmd.indexCount = 6u;

    if (aabbVisible(0u, minp, maxp)) {
        uint dst = atomicAdd(bbCnt0.count, 1);
        if (dst < bbCmds0.cmds.length()) bbCmds0.cmds[dst] = bbCmd;
        dst = atomicAdd(impCnt0.count, 1);
        if (dst < impCmds0.cmds.length()) impCmds0.cmds[dst] = impCmd;
    }
    if (aabbVisible(1u, minp, maxp)) {
        uint dst = atomicAdd(bbCnt1.count, 1);
        if (dst < bbCmds1.cmds.length()) bbCmds1.cmds[dst] = bbCmd;
        dst = atomicAdd(impCnt1.count, 1);
        if (dst < impCmds1.cmds.length()) impCmds1.cmds[dst] = impCmd;
    }
    if (aabbVisible(2u, minp, maxp)) {
        uint dst = atomicAdd(bbCnt2.count, 1);
        if (dst < bbCmds2.cmds.length()) bbCmds2.cmds[dst] = bbCmd;
        dst = atomicAdd(impCnt2.count, 1);
        if (dst < impCmds2.cmds.length()) impCmds2.cmds[dst] = impCmd;
    }
}
