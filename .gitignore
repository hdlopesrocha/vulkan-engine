# Ignore the built executable(s)
app
*/app
*.out

# Object files and temporary build files
*.o
*.obj
*.lo
*.la
*.pdf
*.aux
*.toc

# Static and shared libraries
*.a
*.so
*.dll
*.dylib

# Compiled shader binaries (SPIR-V)
*.spv

# Build directories
/build/
/bin/
/dist/
/scenes/
# Generated video assets (make videos / make videos-extra outputs)
/video_textures/
# Video assets: base/ (3 shortest clips) is committed, extra/ is a local
# library that can be very large (see videos/README.md).
/videos/extra/*
!/videos/extra/.gitkeep

# Converted video textures (make videos) are a regenerable build artifact;
# the sources live in videos/base and videos/extra (see docs/video_textures.md).
/video_textures/

# Logs and runtime files
*.log
*.tmp
*.cache

# Editor/IDE files
.vscode/
.idea/
*~
*.swp

# macOS
.DS_Store

# Thumbs/db
Thumbs.db

# Generated GUI/backends build artifacts
/imgui/
