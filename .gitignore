# Ignore the built executable(s)
app
*/app
*.out

# Object files and temporary build files
*.o
*.obj
*.lo
*.la
*.pdf
*.aux
*.toc

# Static and shared libraries
*.a
*.so
*.dll
*.dylib

# Compiled shader binaries (SPIR-V)
*.spv

# Build directories
/build/
/bin/
/dist/
/scenes/
# Video assets: sources in videos/base (committed) and videos/extra (local,
# can be very large); the converted clips produced by `make videos` keep the
# folder structure in videos/<base|extra>/converted/ and are ignored (see
# videos/.gitignore and docs/videos.md).
/videos/extra/*
!/videos/extra/.gitkeep

# Logs and runtime files
*.log
*.tmp
*.cache

# Editor/IDE files
.vscode/
.idea/
*~
*.swp

# macOS
.DS_Store

# Thumbs/db
Thumbs.db

# Generated GUI/backends build artifacts
/imgui/
# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo
.deepcode/
imgui.ini

# Web viewer build inputs/outputs
node_modules/
server/web/dist/

# Alert-sound playback queue (runtime state of sounds/play.sh)
/sounds/.queue.d/
/sounds/.queue.lock
# Runtime-synthesized alert phrases (sounds/say.sh cache)
/sounds/.dynamic/
